@model ProductsValidation.Models.ProductsIndexViewModel

@{
    ViewData["Title"] = "Products";
}

<section class="py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Products</h1>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="mb-2 text-white">
                <strong>Filter list by product type:</strong>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var category in Enum.GetValues<ProductCategory>())
                {
                    <a asp-action="Index" asp-route-type="@category" asp-route-page="1" class="btn btn-outline-primary btn-sm">@category</a>
                }
                <a asp-action="Index" asp-route-page="1" class="btn btn-outline-dark btn-sm">All</a>
            </div>
            <div class="mb-2 text-white">
                <strong>Bulk edit prices by product type:</strong>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var category in Enum.GetValues<ProductCategory>())
                {
                    <a asp-action="EditPrices" asp-route-type="@category" class="btn btn-outline-primary btn-sm">@category</a>
                }
            </div>
        </div>
    </div>

    <div class="table-responsive">
<table class="table table-dark table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                Type
            </th>
            <th>
                Name
            </th>
            <th>
                Description
            </th>
            <th>
                Price
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Products) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light me-1">Edit</a>
                <a asp-action="View" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light me-1">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
    </div>

    <div class="d-flex justify-content-between mt-3">
        @if (Model.CurrentPage <= 1)
        {
            <span class="btn btn-secondary disabled">Previous</span>
        }
        else
        {
            <a asp-action="Index" asp-route-type="@Model.Type" asp-route-page="@(Model.CurrentPage - 1)" class="btn btn-primary">Previous</a>
        }

        @if (Model.CurrentPage >= Model.TotalPages)
        {
            <span class="btn btn-secondary disabled">Next</span>
        }
        else
        {
            <a asp-action="Index" asp-route-type="@Model.Type" asp-route-page="@(Model.CurrentPage + 1)" class="btn btn-primary">Next</a>
        }
    </div>
</section>
